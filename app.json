{
  "expo": {
    "name": "Reaux Labs",
    "slug": "reaux-labs-mobile",
    "scheme": "reauxlabs",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Example.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/Logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9F506"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.babbaranish.reauxlabsmobile",
      "infoPlist": {
        "NSCameraUsageDescription": "REAUX Labs needs camera access to upload gym photos.",
        "NSPhotoLibraryUsageDescription": "REAUX Labs needs photo library access to upload images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.babbaranish.reauxlabsmobile",
      "versionCode": 2,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "reauxlabs",
              "host": "reset-password"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "notification": {
      "icon": "./assets/Example.png",
      "color": "#F9F506",
      "androidMode": "default",
      "androidCollapsedTitle": "#{unread_notifications} new notifications"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "REAUX Labs needs access to your photos to upload images.",
          "cameraPermission": "REAUX Labs needs camera access to take photos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/Example.png",
          "color": "#F9F506",
          "mode": "default"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "59c6bc41-16ca-4825-888c-aad238b337de"
      }
    },
    "owner": "reauxlabs"
  }
}
